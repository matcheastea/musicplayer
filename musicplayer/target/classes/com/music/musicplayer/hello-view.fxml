<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.music.musicplayer.MusicController" prefWidth="500.0" prefHeight="450.0"
      stylesheets="@style.css">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="lblNowPlaying" text=" No Song Selected" />

    <TableView fx:id="songTable" prefHeight="250.0" prefWidth="460.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
            <TableColumn fx:id="colTitle" prefWidth="150.0" text="Title" />
            <TableColumn fx:id="colArtist" prefWidth="130.0" text="Artist" />
            <TableColumn fx:id="colAlbum" prefWidth="130.0" text="Album" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER" spacing="12.0">
        <Button text="⏮ Prev" onAction="#onPrevClick"/>
        <Button fx:id="btnPlay" text="▶ Play" onAction="#onPlayClick"/>
        <Button text="⏸ Pause" onAction="#onPauseClick"/>
        <Button text="⏹ Stop" onAction="#onStopClick"/>
        <Button text="⏭ Next" onAction="#onNextClick"/>
    </HBox>

    <Button fx:id="btnAdd" text="+ Add MP3 Song" onAction="#onAddSongClick"/>
</VBox>