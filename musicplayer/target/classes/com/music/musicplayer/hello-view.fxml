<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://造型.com/fxml" 
      fx:controller="com.music.musicplayer.MusicController" prefWidth="500.0" prefHeight="450.0">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="lblNowPlaying" text="No Song Selected" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

    <TableView fx:id="songTable" prefHeight="250.0" prefWidth="460.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
            <TableColumn fx:id="colTitle" prefWidth="150.0" text="Title" />
            <TableColumn fx:id="colArtist" prefWidth="130.0" text="Artist" />
            <TableColumn fx:id="colAlbum" prefWidth="130.0" text="Album" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="⏮ Prev" onAction="#onPrevClick"/>
        <Button text="▶ Play" onAction="#onPlayClick" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="⏸ Pause" onAction="#onPauseClick"/>
        <Button text="⏹ Stop" onAction="#onStopClick"/>
        <Button text="⏭ Next" onAction="#onNextClick"/>
    </HBox>

    <Button text="➕ Add MP3 Song" onAction="#onAddSongClick" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
</VBox>